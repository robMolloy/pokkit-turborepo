{
  "hosting": [
    {
      "target": "pokkit-whisper",
      "public": "apps/pokkit-whisper/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "pokkit-docs",
      "public": "apps/pokkit-starter/pokkit-starter-docs/build",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
