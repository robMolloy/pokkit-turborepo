{
  "name": "pokkit-starter-db-ts-testing",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build-source-in-staging:any-changed-deps": "go build -o ../pokkit-starter-db-ts-testing/staging-test-build/app-db ../pokkit-starter-db/src/...",
    "build-source-in-staging": "pnpm run build-source-in-staging:any-changed-deps",
    "copy-pbconfig-to-staging": "rm -rf ./staging-test-build/pb_config && cp -r ../pokkit-starter-db/src/pb_config ./staging-test-build/pb_config",
    "copy-staging-to-source": "rm -rf ./source-test-build && cp -r ./staging-test-build ./source-test-build",
    "remove-staging": "rm -rf ./staging-test-build",
    "build-source": "pnpm run build-source-in-staging && pnpm run copy-pbconfig-to-staging && pnpm run copy-staging-to-source && pnpm run remove-staging",
    "build-source:on-change-to-dev": "node ../../../node_modules/nodemon/bin/nodemon.js --watch ../../../packages --watch ../pokkit-starter-db/src --on-change-only --exec \"pnpm run build-source\" --ext \"go,json\"",
    "pre-test": "pnpm run build-source",
    "test-companion": "pnpm run build-source:on-change-to-dev",
    "test": "vitest",
    "test-once": "vitest run",
    "test-ui": "vitest --ui",
    "tsc": "node_modules/.bin/tsc --project ./tsconfig.json --noemit --watch",
    "attempt-kill-port": "kill -9 $(lsof -ti :\"$PORT\" 2>/dev/null | head -n 1) 2>/dev/null || true",
    "kill-port": "PORT=$PORT npm run attempt-kill-port",
    "get-platform-arch": "node -e \"console.log(process.platform + '_' + process.arch + (process.platform === 'win32' ? '.exe' : ''))\""
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.10",
    "@vitest/ui": "4.0.18",
    "dotenv": "^17.2.3",
    "fs-extra": "^11.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@repo/pokkit-testing": "workspace:^",
    "@repo/pokkit-db-permissions-ts-helpers": "workspace:^",
    "@repo/pokkit-db-deployments-ts-helpers": "workspace:^",
    "@repo/pokkit-db-blog-ts-helpers": "workspace:^",
    "@repo/pokkit-utils": "workspace:^",
    "pocketbase": "^0.26.6",
    "zod": "^4.3.6"
  }
}
