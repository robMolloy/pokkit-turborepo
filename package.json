{
  "name": "pokkit-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "tsc:web-ui": "turbo run tsc --filter=web --filter=@repo/ui",
    "tsc": "turbo run tsc",
    "css-build": "turbo run css-build",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "build-whisper": "pnpm add -w @tailwindcss/oxide-linux-x64-gnu && pnpm install --no-optional=false && pnpm run build --filter=@repo/pokkit-shadcn && pnpm run build --filter=@repo/pokkit-components && pnpm run build --filter=pokkit-whisper",
    "build-whisper-db": "turbo run build --filter=pokkit-whisper-db",
    "pre-dev-pokkit-deployer": "turbo run pre-dev tsc --filter=pokkit-deployer-*",
    "dev-pokkit-deployer": "turbo run pre-dev dev tsc --filter=pokkit-deployer-*",
    "tsc-pokkit-deployer": "turbo run tsc --filter=pokkit-deployer-db --filter=pokkit-deployer-ui",
    "build-pokkit-deployer-db": "turbo run build --filter=pokkit-deployer-db"
  },
  "devDependencies": {
    "firebase-tools": "^15.11.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.12",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
